---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="border-t-2 border-brutal-text mt-32">
  <Container class="py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-10">
      <div class="col-span-2 lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-5">
          <div class="w-10 h-10 rounded-xl bg-accent-yellow border-2 border-brutal-text flex items-center justify-center font-display font-black text-lg">
            ES
          </div>
          <span class="font-display font-black text-xl">ExamScanner</span>
        </a>
        <p class="font-body text-brutal-text/60 mb-6 max-w-sm">
          AI-powered answer sheet scanner for modern educators. Scan, grade, and export results in seconds.
        </p>
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl border-2 border-brutal-text flex items-center justify-center hover:bg-accent-yellow transition-colors duration-200 cursor-pointer">
            <Icon name="upload" class="w-4 h-4" />
          </div>
          <div class="w-9 h-9 rounded-xl border-2 border-brutal-text flex items-center justify-center hover:bg-accent-blue transition-colors duration-200 cursor-pointer">
            <Icon name="users" class="w-4 h-4" />
          </div>
          <div class="w-9 h-9 rounded-xl border-2 border-brutal-text flex items-center justify-center hover:bg-accent-green transition-colors duration-200 cursor-pointer">
            <Icon name="star" class="w-4 h-4" />
          </div>
        </div>
      </div>
      <div>
        <h4 class="font-display font-black text-sm mb-4">Product</h4>
        <ul class="space-y-3">
          <li><a href="/#features" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Features</a></li>
          <li><a href="/#pricing" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Pricing</a></li>
          <li><a href="/scan" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Scanner</a></li>
          <li><a href="/dashboard" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Dashboard</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-display font-black text-sm mb-4">Company</h4>
        <ul class="space-y-3">
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">About</a></li>
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Blog</a></li>
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Careers</a></li>
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-display font-black text-sm mb-4">Legal</h4>
        <ul class="space-y-3">
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Privacy</a></li>
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Terms</a></li>
          <li><a href="#" class="font-body text-sm text-brutal-text/60 hover:text-brutal-text transition-colors">Security</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t-2 border-brutal-text/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-body text-sm text-brutal-text/40">&copy; 2024 ExamScanner. All rights reserved.</p>
      <p class="font-body text-sm text-brutal-text/40">Made with dedication for educators</p>
    </div>
  </Container>
</footer>
