---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b-2 border-brutal-text">
  <Container class="flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-accent-yellow border-2 border-brutal-text flex items-center justify-center font-display font-black text-lg transition-transform duration-300 group-hover:-rotate-6">
        ES
      </div>
      <span class="font-display font-black text-xl">ExamScanner</span>
    </a>
    <nav class="hidden md:flex items-center gap-1">
      <a href="/" class="px-4 py-2 font-display font-bold text-sm rounded-pill hover:bg-brutal-text/5 transition-colors duration-200">Home</a>
      <a href="/#features" class="px-4 py-2 font-display font-bold text-sm rounded-pill hover:bg-brutal-text/5 transition-colors duration-200">Features</a>
      <a href="/#pricing" class="px-4 py-2 font-display font-bold text-sm rounded-pill hover:bg-brutal-text/5 transition-colors duration-200">Pricing</a>
      <a href="/dashboard" class="px-4 py-2 font-display font-bold text-sm rounded-pill hover:bg-brutal-text/5 transition-colors duration-200">Dashboard</a>
    </nav>
    <div class="flex items-center gap-3">
      <a href="/login" class="hidden sm:inline-flex px-5 py-2.5 font-display font-bold text-sm rounded-pill border-2 border-brutal-text hover:bg-brutal-text/5 transition-all duration-200">Sign In</a>
      <Button variant="primary" size="sm" href="/scan">Get Started</Button>
      <button id="mobile-menu-btn" class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl border-2 border-brutal-text" aria-label="Toggle menu">
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </Container>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  if (menuBtn) {
    menuBtn.addEventListener('click', () => {
      alert('Mobile menu would open here');
    });
  }
</script>
