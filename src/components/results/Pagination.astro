---
import Icon from '../ui/Icon.astro';

export interface Props {
  currentPage?: number;
  totalPages?: number;
  class?: string;
}

const { currentPage = 1, totalPages = 5, class: className = '' } = Astro.props;
---

<div class={`flex flex-col sm:flex-row items-center justify-between gap-4 ${className}`}>
  <p class="font-body text-sm text-brutal-text/40">
    Showing <span class="font-display font-bold text-brutal-text">1</span> to <span class="font-display font-bold text-brutal-text">8</span> of <span class="font-display font-bold text-brutal-text">24</span> results
  </p>
  <div class="flex items-center gap-2">
    <button class="w-9 h-9 rounded-xl border-2 border-brutal-text flex items-center justify-center hover:bg-brutal-text/5 transition-all duration-200 active:scale-[0.97]" aria-label="Previous page">
      <Icon name="chevron-left" class="w-4 h-4" />
    </button>
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
      <button
        class={`w-9 h-9 rounded-xl border-2 border-brutal-text font-display font-bold text-sm transition-all duration-200 active:scale-[0.97] ${
          page === currentPage ? 'bg-accent-yellow shadow-brutal-sm' : 'hover:bg-brutal-text/5'
        }`}
      >
        {page}
      </button>
    ))}
    <button class="w-9 h-9 rounded-xl border-2 border-brutal-text flex items-center justify-center hover:bg-brutal-text/5 transition-all duration-200 active:scale-[0.97]" aria-label="Next page">
      <Icon name="chevron-right" class="w-4 h-4" />
    </button>
  </div>
</div>
