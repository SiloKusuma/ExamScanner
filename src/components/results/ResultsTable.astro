---
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const results = [
  { id: 'S001', name: 'Alex Johnson', score: 48, total: 50, correct: 48, wrong: 2, percentage: 96, grade: 'A' },
  { id: 'S002', name: 'Maria Garcia', score: 45, total: 50, correct: 45, wrong: 5, percentage: 90, grade: 'A-' },
  { id: 'S003', name: 'James Chen', score: 42, total: 50, correct: 42, wrong: 8, percentage: 84, grade: 'B' },
  { id: 'S004', name: 'Sarah Kim', score: 38, total: 50, correct: 38, wrong: 12, percentage: 76, grade: 'C+' },
  { id: 'S005', name: 'David Park', score: 50, total: 50, correct: 50, wrong: 0, percentage: 100, grade: 'A+' },
  { id: 'S006', name: 'Emily Zhang', score: 35, total: 50, correct: 35, wrong: 15, percentage: 70, grade: 'C' },
  { id: 'S007', name: 'Michael Brown', score: 44, total: 50, correct: 44, wrong: 6, percentage: 88, grade: 'B+' },
  { id: 'S008', name: 'Lisa Anderson', score: 40, total: 50, correct: 40, wrong: 10, percentage: 80, grade: 'B-' },
];

const gradeColors: Record<string, string> = {
  'A+': 'bg-accent-green',
  'A': 'bg-accent-green',
  'A-': 'bg-accent-green/70',
  'B+': 'bg-accent-blue',
  'B': 'bg-accent-blue/70',
  'B-': 'bg-accent-blue/50',
  'C+': 'bg-accent-yellow',
  'C': 'bg-accent-yellow/70',
  'D': 'bg-accent-red/70',
  'F': 'bg-accent-red',
};
---

<div class={`overflow-hidden ${className}`}>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b-2 border-brutal-text">
          <th class="text-left font-display font-bold text-sm pb-3 pr-4">Student ID</th>
          <th class="text-left font-display font-bold text-sm pb-3 pr-4">Name</th>
          <th class="text-center font-display font-bold text-sm pb-3 px-2">Score</th>
          <th class="text-center font-display font-bold text-sm pb-3 px-2">Correct</th>
          <th class="text-center font-display font-bold text-sm pb-3 px-2">Wrong</th>
          <th class="text-center font-display font-bold text-sm pb-3 px-2">Percentage</th>
          <th class="text-center font-display font-bold text-sm pb-3 pl-4">Grade</th>
        </tr>
      </thead>
      <tbody>
        {results.map((row) => (
          <tr class="border-b border-brutal-text/10 hover:bg-brutal-text/[0.02] transition-colors">
            <td class="py-3.5 pr-4">
              <span class="font-body text-sm font-medium">{row.id}</span>
            </td>
            <td class="py-3.5 pr-4">
              <span class="font-display font-bold text-sm">{row.name}</span>
            </td>
            <td class="text-center py-3.5 px-2">
              <span class="font-display font-bold text-sm">{row.score}/{row.total}</span>
            </td>
            <td class="text-center py-3.5 px-2">
              <span class="font-display font-bold text-sm text-accent-green">{row.correct}</span>
            </td>
            <td class="text-center py-3.5 px-2">
              <span class="font-display font-bold text-sm text-accent-red">{row.wrong}</span>
            </td>
            <td class="text-center py-3.5 px-2">
              <span class="font-display font-bold text-sm">{row.percentage}%</span>
            </td>
            <td class="text-center py-3.5 pl-4">
              <span class={`inline-block font-display font-bold text-xs rounded-pill px-3 py-1 border border-brutal-text ${gradeColors[row.grade] || 'bg-brutal-text/5'}`}>
                {row.grade}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
