---
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  icon: string;
  label: string;
  value: string;
  change?: string;
  trend?: 'up' | 'down';
  color: string;
}

const { icon, label, value, change, trend = 'up', color } = Astro.props;
---

<Card padding="md" class="group">
  <div class="flex items-start justify-between mb-4">
    <div class={`w-11 h-11 rounded-xl ${color} border-2 border-brutal-text flex items-center justify-center group-hover:scale-110 transition-transform duration-300`}>
      <Icon name={icon} class="w-5 h-5" />
    </div>
    {change && (
      <span class={`inline-flex items-center gap-1 text-xs font-display font-bold rounded-pill px-2.5 py-1 border ${
        trend === 'up' ? 'bg-accent-green/30 text-accent-green border-brutal-text' : 'bg-accent-red/30 text-accent-red border-brutal-text'
      }`}>
        <Icon name={trend === 'up' ? 'arrow-right' : 'arrow-right'} class={`w-3 h-3 ${trend === 'up' ? '' : 'rotate-90'}`} />
        {change}
      </span>
    )}
  </div>
  <p class="text-3xl font-display font-black mb-1">{value}</p>
  <p class="font-body text-sm text-brutal-text/60">{label}</p>
</Card>
